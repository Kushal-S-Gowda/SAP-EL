# Copy to .env and adjust. Do not commit .env.

# Operating mode for documentation / dashboard status writers:
# live | demo | historical
RTSED_MODE=live

# Comma-separated Yahoo Finance NSE tickers
RTSED_STOCKS=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS

RTSED_POLL_INTERVAL_SECONDS=60
RTSED_FINALIZATION_DELAY_SECONDS=120
RTSED_OVERLAP_WINDOW_SECONDS=600
RTSED_MARKET_DATA_PROVIDER=yahoo

RTSED_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RTSED_STOCK_DATA_TOPIC=stock_data
RTSED_STOCK_EVENTS_TOPIC=stock_events

RTSED_POSTGRES_HOST=localhost
RTSED_POSTGRES_PORT=5432
RTSED_POSTGRES_DB=rtsed
RTSED_POSTGRES_USER=rtsed_user
RTSED_POSTGRES_PASSWORD=rtsed_password

RTSED_LOG_LEVEL=INFO
RTSED_REPLAY_MAX_RECORDS=1000
RTSED_REPLAY_DELAY=0.01
RTSED_DEMO_REPLAY_DELAY=0.2

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# llama3.2 is commonly installed locally. For stronger tool calling: ollama pull llama3.1
OLLAMA_MODEL=llama3.2
RTSED_AGENT_GROUP_ID=rtsed-investigation-agent
RTSED_AGENT_MAX_TOOL_STEPS=8
